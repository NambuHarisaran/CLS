# Firebase service account JSON string (from Firebase Console > Project Settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCDefgh-xxxxxxxxxxxx

# Secret for Telegram webhook verification (any random string, 16-256 chars)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Secret for the Vercel cron endpoint (any random string)
CRON_SECRET=your_cron_secret_here

# Admin email (must match the Google account that will be admin)
VITE_ADMIN_EMAIL=nambuharisaran123@gmail.com

# Your Telegram bot username (without @)
VITE_TELEGRAM_BOT_USERNAME=YourBotName
